# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o .env no GitHub

# ID da planilha Google Sheets (extraído da URL da planilha)
# Ex: https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/edit
GOOGLE_SHEETS_ID=cole_o_id_da_sua_planilha_aqui

# Caminho para o arquivo JSON de credenciais da conta de serviço
# Gerado em: Google Cloud Console > IAM > Contas de Serviço > Criar chave (JSON)
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
